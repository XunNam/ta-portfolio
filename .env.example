# Placeholder values only. Do not commit real secrets.

PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep both names documented during the transition period.
# The current repo uses DATABASE_URL in src/payload.config.ts.
# The migration plan standardizes on DATABASE_URI for future clarity.
DATABASE_URI=mongodb://127.0.0.1:27017/your-database-name
DATABASE_URL=mongodb://127.0.0.1:27017/your-database-name

# Cloudflare R2 via S3-compatible configuration
S3_BUCKET=your-r2-bucket-name
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_PUBLIC_URL=https://assets.example.com
